page{
  width: 100vw;
  background-image:linear-gradient(to bottom,#a0d6e4,#d1cdcd);
}
.content{
  width: 100%;
}
.carinfo{
  width: 100%;
  height: 30%;
}
.info{
  width: 100%;
  height: 40%;
}
.pai{
  padding: 40rpx 0 20rpx 20rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.chejia{
  padding-left:20rpx;
  font-size: 30rpx;
}
.cheng{
  padding-left:20rpx;
  font-size: 30rpx;
}
.detail{
  width:100%;
  height: 60%;
  display: flex;
  align-items: center;
}
.detail1{
  width: 55%;
}
.licheng{
  width: 100%;
  padding-left: 20rpx;
  padding-top: 40rpx;
}
.chongdian{
  width:100%;
  padding-left: 20rpx;
  padding-top: 10rpx;
  display: flex;
}
.chongView{
  width:15%;
}
.chongImg{
  width: 50rpx;
  height: 50rpx;
}
.chongstatus{
  width: 70%;
  font-size:30rpx;
}
.dianliang{
  width: 100%;
  padding-left: 20rpx;
  padding-top: 10rpx;
  display: flex;
}
.dianView{
  width:15%;
}
.dianImg{
  width: 50rpx;
  height: 50rpx;
}
.dianNums{
  width: 70%;
  font-size:30rpx;
}
.sudu{
  width: 100%;
  padding-left: 20rpx;
  padding-top: 10rpx;
  display: flex;
}
.suView{
  width:15%;
}
.suImg{
  width: 50rpx;
  height: 50rpx;
}
.dianNums{
  width: 70%;
  font-size:30rpx;
}
.detail2{
  width: 50%;
  display: flex;
  align-items: center;
}
.carImg{
  width: 400rpx;
  height:200rpx;
}
.map{
  width: 100%;
}
.dangqian{
  width: 100%;
  padding-top: 40rpx;
  padding-left: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.add{
  padding-top: 20rpx;
  padding-left: 20rpx;
}
.addinfo{
  width: 100%;
  height: 60rpx;
  line-height: center;
}
.weidu{
  margin-left: 40rpx;
}
.other{
  width: 100%;
  background-image:linear-gradient(to bottom,#a0d6e4,#d1cdcd);
}
.otitle{
  width: 100%;
  padding-top: 40rpx;
  padding-left: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.oinfo{
  padding-left: 20rpx;

}