<block>
 <view class="centent">
  <view class="logo">
    <image class="logoimg" mode="" src="../../../assets/images/lebian.jpg"></image>
  </view>
  <view class="inputArea">
    <view class="inputTitle">
        <label>手机号</label>
    </view>
    <view class="phone">
      <input type="text" bindinput="bindPhone" class="inputPhone" bindblur="checkPhone" />
    </view>
    <view class="line"></view>
  </view>
  <view class="inputArea" style="margin-top: 20rpx;">
    <view class="inputTitle">
        <label>密码</label>
    </view>
    <view class="phone">
      <input type="text" password="true" bindinput="bindPassword" class="inputPhone" />
    </view>
    <view class="line"></view>
  </view>
  <view class="regArea">
      <text class="regText" bindtap="register">注册账号</text>
  </view>
  <view class="buttonArea">
    <button class="buttons" bindtap="loginIn">登录</button>
  </view>
 </view> 
  <view class="signUp-tip">
    <checkbox-group bindchange="checkboxChange" style="float: left;">
      <checkbox value="agree"/>
    </checkbox-group>
    <view class="signUp-tip-txt">我已阅读并同意
      <text class="signUp-tip-txt-protocol" bindtap="gotoxieyi">《用户协议》</text>
      和
      <text class="signUp-tip-txt-protocol" bindtap="goyinsi">《隐私政策》</text>
    </view>
  </view>
</block>