page{
  width: 100vw;
  height: 100vh;
  background-color: #e1e1e1;
}
.content{
  width: 100%;
  height: 100vh;
}
.forms{
  width: 94vw;
  height: 40vh;
  background-color: #ffffff;
  border-radius: 20rpx;
  margin-top: 20rpx;
  margin-left: 3vw;
}
.titleArea{
  padding: 20rpx 20rpx;
  font-size: 34rpx;
  font-weight: 600;
}
.inputArea{
  width: 90%;
  height: 80rpx;
  line-height: 80rpx;
  border-bottom: 1rpx solid #999;
  margin-left: 5%;
  margin-top: 10rpx;
}
.buttonArea{
  position: absolute;
  top: 90%;
  width: 100%;
}
.buttons{
  width: 90%;
  background-color: #0c9cda;
  color: #fff;
}