            content: "司机位置", //文本
            bgColor: "#fff", //背景色
            padding: "10px 30px", //文本边缘留白
            borderRadius: "15px", //边框圆角
            borderWidth: "1px", //边框宽度
            borderColor: "#ccc", //边框颜色
            color: '#000', //文字颜色
            textAlign: 'center', //对其方式,
            display: 'ALWAYS', //常显  BYCLICK点击显示
          }
        };
        var list = res.data.detailList;
        list.forEach((value, index) => {
            var mark ={
              id: 0,
              latitude: res.data.CarDirId_Latitude,
              longitude: res.data.CarDirId_Longitude,
              iconPath: '/assets/images/chengke.png',
              width: 30,
              height: 30,
              callout: {
                content: "司机位置", //文本
                bgColor: "#fff", //背景色
                padding: "10px 30px", //文本边缘留白
                borderRadius: "15px", //边框圆角
                borderWidth: "1px", //边框宽度
                borderColor: "#ccc", //边框颜色
                color: '#000', //文字颜色
                textAlign: 'center', //对其方式,
                display: 'ALWAYS', //常显  BYCLICK点击显示
              }
            };
            var phone = value.PersonalIds;
            var arr = phone.split(',');
            var str = arr[0];
            var arr1 = str.split("|");
            var nums = arr1[0];
            mark.id=index;
            mark.latitude = value.IntoLatitude;
            mark.longitude = value.IntoLongitude;
            mark.callout.content = "尾号"+nums.slice(-4)+"\n"+"起点："+value.IntoLocation;
            markers.push(mark)
        })
        list.forEach((value, index) => {
          var mark ={
            id: 0,
            latitude: res.data.CarDirId_Latitude,
            longitude: res.data.CarDirId_Longitude,
            iconPath: '/assets/images/chengke.png',
            width: 30,
            height: 30,
            callout: {
              content: "司机位置", //文本
              bgColor: "#fff", //背景色
              padding: "10px 30px", //文本边缘留白
              borderRadius: "15px", //边框圆角
              borderWidth: "1px", //边框宽度
              borderColor: "#ccc", //边框颜色
              color: '#000', //文字颜色
              textAlign: 'center', //对其方式,
              display: 'ALWAYS', //常显  BYCLICK点击显示
            }
          };
          var phone = value.PersonalIds;
          var arr = phone.split(',');
          var str = arr[0];
          var arr1 = str.split("|");
          var nums = arr1[0];
          mark.id = index+list.length;
          mark.latitude = value.OffLatitude;
          mark.longitude = value.OffLongitude;
          mark.callout.content = "尾号"+nums.slice(-4)+"\n"+"终点："+value.OffLocation;
          markers.push(mark)
      })
        markers.push(marker)
        wx.setStorageSync('markers', markers);
        that.setData({
          markers:markers
        })
        that.driving(res.data.startLat, res.data.startLon, res.data.endLat,res.data.endLon);
        }else{
          wx.showToast({
            title: res.msg,
            icon:"none"
          })
        }
      }, err => {
        this.setData({
          loadingFailed: true
        })
        return false;
      })
    }else{
      that.setData({
        isshow:false
      })
    }
  },
  getNewtime(originalDateTime){
    var dateString = originalDateTime.replace(/-/g, '/');
    var date = new Date(dateString);
    // 获取年月日
    var year = date.getFullYear();
    var month = String(date.getMonth() + 1).padStart(2, '0');
    var day = String(date.getDate()).padStart(2, '0');
    
    // 获取小时并向下取整
    var hour = String(date.getHours()).padStart(2, '0');
    var nextHour = String(date.getHours() + 1).padStart(2, '0');
    
    // 组合成时间区间格式
    return `${year}-${month}-${day} ${hour}:00-${nextHour}:00`;
  },
