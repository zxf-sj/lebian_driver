/* pages/busOngoingDetail/busOngoingDetail.wxss  第二套·进行中班次详情 */
page {
  background: #f5f6f8;
}
.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.body {
  padding: 24rpx;
}

/* 班次概览卡：滚动时吸顶 */
.summary-sticky {
  position: sticky;
  top: 0;
  z-index: 20;
  /* 撑满 .body 的左右 padding，吸顶后整条不透明，滚动内容不会从两侧/上沿透出 */
  margin: 0 -24rpx;
  padding: 0 24rpx 12rpx;
  background: #f5f6f8;
}

/* 班次概览卡 */
.summary-card {
  background: linear-gradient(135deg, #24486e, #16324f);
  border-radius: 20rpx;
  padding: 28rpx;
  color: #fff;
  box-shadow: 0 6rpx 18rpx rgba(22, 50, 79, 0.16);
}
.summary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.summary-left {
  flex: 1;
  min-width: 0;
}
.summary-route {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.summary-from,
.summary-to {
  font-size: 34rpx;
  font-weight: 700;
}
.summary-arrow {
  margin: 0 14rpx;
  color: #ff8a4c;
  font-size: 30rpx;
}
/* 右侧竖排：已发车在上，第 N/M 站在下 */
.summary-right {
  flex-shrink: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.summary-status {
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: #ff8a4c;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}
.summary-stop {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}
.summary-open {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: #ff8a4c;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}
.summary-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}
.summary-divider {
  margin: 24rpx 0 0;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.15);
}
.summary-stats {
  padding-top: 24rpx;
  display: flex;
}
.stat-col {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}
.stat-num.orange {
  color: #ff8a4c;
}
.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
}

/* 本站乘车人名单 */
.pax-card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
}
.pax-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pax-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}
.pax-sub {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #8a94a2;
}
.pax-tab-num {
  font-size: 22rpx;
  opacity: .8;
}
.pax-tabs {
  margin-top: 20rpx;
  width: 100%;
  white-space: nowrap;
}
.pax-tab {
  display: inline-block;
  font-size: 24rpx;
  color: #6b7280;
  background: #f2f4f7;
  border-radius: 999rpx;
  padding: 8rpx 26rpx;
  margin-right: 16rpx;
}
.pax-tab.on {
  color: #fff;
  background: #1b3a5c;
  font-weight: 600;
}
/* 乘客列表：固定高度 ≈3 行，超出上下滑动 */
.pax-scroll {
  height: 444rpx;
  margin-top: 4rpx;
}
.pax-item {
  margin-top: 20rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
}
.pax-main {
  flex: 1;
  min-width: 0;
}
.pax-name-row {
  display: flex;
  align-items: center;
}
.pax-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}
.pax-state {
  margin-left: 14rpx;
  font-size: 20rpx;
  color: #fff;
  border-radius: 999rpx;
  padding: 3rpx 16rpx;
}
.pax-state-boarded {
  background: #2ba84a;
}
.pax-state-pending {
  background: #e8890c;
}
.pax-state-absent {
  background: #9ca3af;
}
.pax-state-contacted {
  background: #1b3a5c;
}
.pax-state-delay {
  background: #e64340;
}
.pax-meta {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
}
.pax-seat {
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2937;
  margin-right: 16rpx;
}
.pax-phone {
  font-size: 24rpx;
  color: #9ca3af;
}
.pax-note {
  margin-left: 14rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #e8890c;
}
.pax-actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}
.pax-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #eef0f3;
  color: #4b5563;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
}
.pax-btn-ok {
  background: #d9f2e1;
  color: #2ba84a;
  font-weight: 700;
}
.pax-empty {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #9ca3af;
  padding: 30rpx 0;
}

/* 站点时间轴 */
.timeline-card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
}
.tl-item {
  display: flex;
}
.tl-rail {
  width: 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}
.tl-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  margin-top: 8rpx;
  flex-shrink: 0;
}
.tl-line {
  width: 4rpx;
  flex: 1;
  margin: 6rpx 0;
  border-left: 4rpx dashed #c4c9d2;
}
.tl-item.done .tl-dot {
  background: #1b3a5c;
}
.tl-item.current .tl-dot {
  background: #ff8a4c;
  box-shadow: 0 0 0 6rpx rgba(255, 138, 76, 0.2);
}
.tl-item.todo .tl-dot {
  background: #fff;
  border: 4rpx solid #c4c9d2;
  box-sizing: border-box;
}
.tl-content {
  flex: 1;
  min-width: 0;
  padding-bottom: 36rpx;
}
.tl-current-box {
  background: #fdf3ea;
  border: 1rpx solid #f5c9a4;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
}
.tl-name-row {
  display: flex;
  align-items: center;
}
.tl-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}
.tl-tag {
  margin-left: 14rpx;
  font-size: 20rpx;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}
.tl-tag-start {
  color: #6b7280;
  background: #eef0f3;
}
.tl-tag-current {
  color: #fff;
  background: #ff8a4c;
}
.tl-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

/* 底部倒计时与确认按钮 */
.tl-footer {
  margin-top: 8rpx;
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
}
.tl-footer-eta {
  color: #ff8a4c;
  font-weight: 700;
}
.tl-confirm {
  margin-top: 24rpx;
  background: #f2f4f7;
  color: #1b3a5c;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
}
.tl-confirm::after {
  border: none;
}

/* 确认到站弹框 */
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal {
  width: 620rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-sizing: border-box;
}
.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
}
.modal-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f2f4f7;
  color: #6b7280;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-info {
  margin-top: 24rpx;
  background: #f7f8fa;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
}
.modal-info-row {
  display: flex;
  align-items: center;
}
.modal-info-row + .modal-info-row {
  margin-top: 14rpx;
}
.mi-label {
  font-size: 24rpx;
  color: #9ca3af;
  width: 100rpx;
  flex-shrink: 0;
}
.mi-value {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
}
.mi-plan {
  font-size: 22rpx;
  color: #9ca3af;
}
.modal-field-label {
  margin-top: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}
.modal-time-box {
  margin-top: 16rpx;
  height: 88rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.modal-time {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}
.modal-time-icon {
  font-size: 30rpx;
  color: #6b7280;
}
.modal-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.6;
}
.modal-btns {
  margin-top: 32rpx;
  display: flex;
}
.modal-btns button {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  line-height: 2.6;
}
.modal-btns button + button {
  margin-left: 20rpx;
}
.modal-btn-plain {
  background: #f2f4f7;
  color: #1b3a5c;
}
.modal-btn-primary {
  background: #ff8a4c;
  color: #fff;
}
.modal-btn-plain::after,
.modal-btn-primary::after {
  border: none;
}

/* ===== 站点订单卡片（订单维度） ===== */
.order-item {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
}
.order-item:first-child { margin-top: 10rpx; }
.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.order-title-wrap {
  flex: 1;
  min-width: 0;
}
.order-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.order-meta {
  display: flex;
  flex-direction: column;
  margin-top: 8rpx;
}
.order-phone {
  font-size: 26rpx;
  color: #1b3a5c;
}
.order-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a94a2;
}
.order-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}
.order-btn {
  margin-left: 16rpx;
  padding: 0 26rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid #d7dbe2;
  background: #fff;
  color: #333;
}
.order-btn-ok {
  border-color: #2ba84a;
  background: #2ba84a;
  color: #fff;
}
.order-btn-plain {
  border-color: #e0b4b1;
  color: #c0392b;
}
.order-btn.is-disabled {
  opacity: .45;
}

/* ===== 订单状态标签 ===== */
.order-status {
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.order-status-ok {
  background: #2ba84a;
}
.order-status-no {
  background: #9ca3af;
}

/* ===== 多人订单乘客明细 ===== */
.order-pax-list {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #fff;
  border-radius: 10rpx;
}
.order-pax-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}
.order-pax-row + .order-pax-row {
  border-top: 1rpx solid #f0f0f0;
}
.order-pax-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
  width: 140rpx;
}
.order-pax-phone {
  flex: 1;
  font-size: 26rpx;
  color: #6b7280;
}
.order-pax-state {
  font-size: 22rpx;
  color: #9ca3af;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: #f2f4f7;
}
.order-pax-state.boarded {
  color: #2ba84a;
  background: #d9f2e1;
}

/* ===== 确认上车弹框 ===== */
.confirm-mode-title {
  margin-top: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}
.confirm-mode-group {
  margin-top: 16rpx;
  display: flex;
}
.confirm-mode-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  border-radius: 12rpx;
  background: #f2f4f7;
  color: #4b5563;
  border: 2rpx solid transparent;
}
.confirm-mode-btn.on {
  background: #eef4ff;
  color: #1b3a5c;
  border-color: #1b3a5c;
  font-weight: 600;
}
.confirm-mode-btn + .confirm-mode-btn {
  margin-left: 16rpx;
}
.confirm-num-box {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
}
.confirm-num-label {
  font-size: 28rpx;
  color: #4b5563;
}
.confirm-num-input {
  width: 160rpx;
  height: 56rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #1b3a5c;
  background: #fff;
  border: 2rpx solid #d7dbe2;
  border-radius: 10rpx;
}
.confirm-num-ph {
  font-size: 24rpx;
  font-weight: 400;
  color: #c4c9d2;
}

/* ===== 时间轴：点击选中的站点 ===== */
.tl-selected-box {
  background: #eef4ff;
  border: 1rpx solid #b9d0f5;
  border-radius: 14rpx;
}
.tl-tag-view {
  background: #1b3a5c;
  color: #fff;
}
.tl-empty {
  padding: 30rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9ca3af;
}

/* ===== 订单卡片：已上车状态弱化 ===== */
.order-item.is-boarded {
  background: #f2f7f3;
}
