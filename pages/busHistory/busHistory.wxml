<!--pages/busHistory/busHistory.wxml  第二套·历史-->
<view class="page">
  <view class="title">历史行程</view>
  <view class="subtitle">已完成与已取消班次台账</view>

  <!-- 统计条（近 7 天，按已加载数据统计） -->
  <view class="stats">
    <view class="stat-item">
      <view class="stat-value">{{summary.trips7d}}</view>
      <view class="stat-label">近 7 天趟次</view>
    </view>
    <view class="stat-item">
      <view class="stat-value">{{summary.totalPassengers}}</view>
      <view class="stat-label">总载客</view>
    </view>
    <view class="stat-item">
      <view class="stat-value">{{summary.occupancyRate}}</view>
      <view class="stat-label">上座率</view>
    </view>
  </view>

  <!-- 按日期分组列表 -->
  <block wx:for="{{groups}}" wx:key="dateLabel" wx:for-item="group">
    <view class="group-date">{{group.dateLabel}}</view>
    <view class="trip-card" wx:for="{{group.list}}" wx:key="id" wx:for-item="item" data-id="{{item.id}}" bindtap="openDetail">
      <view class="trip-time">{{item.time}}</view>
      <view class="trip-mid">
        <view class="trip-route">{{item.from}} → {{item.to}}</view>
        <view class="trip-meta">{{item.dateLabel}} · {{item.dir}}<text wx:if="{{item.plate}}"> · {{item.plate}}</text></view>
        <view class="trip-meta">载客 {{item.boarded}}/{{item.seatsTotal}} · 空位 {{item.empty}}</view>
      </view>
      <view class="trip-right">
        <view class="trip-status {{item.statusCls}}">{{item.statusText}}</view>
        <text class="trip-arrow">›</text>
      </view>
    </view>
  </block>

  <!-- 列表状态 -->
  <view class="list-tip" wx:if="{{loading}}">加载中…</view>
  <view class="list-tip" wx:elif="{{groups.length && !noMore}}">上拉加载更多</view>
  <view class="list-tip" wx:elif="{{groups.length}}">没有更多了</view>
  <view class="empty" wx:if="{{!loading && firstLoaded && groups.length === 0}}">暂无历史班次</view>

  <tab-bar mode="bus" active-index="{{1}}" />
</view>
