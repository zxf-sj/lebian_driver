/* pages/trip/index.wxss */
.tab-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

/* Tab 头部 */
.tab-header {
  display: flex;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  color: #333;
  background-color: #ffffff;
}

.tab-item.active {
  background-color: #e6f7ff; /* 淡蓝色 */
  font-weight: bold;
  color: #1890ff;
}

/* 内容区域 */
.tab-content {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

.trip-list {
  background-color: #eee;
  border-radius: 12rpx;
  padding: 20rpx;
}

.trip-item {
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #555;
  border-bottom: 1rpx solid #f0f0f0;
}

.trip-item:last-child {
  border-bottom: none;
}
/* //////////////// */
.listBox{
  width: 100%;
  padding: 10rpx 30rpx;
  box-sizing: border-box;
  border-radius: 5px;
  background-color: #fff;
  margin: 10rpx 0;
}
.hiddenBar{
  width: 100%;
  overflow: hidden;
  overflow-y: scroll;
}