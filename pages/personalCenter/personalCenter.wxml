<view class="container">
    <view class="sectionBox">
      <view class="head">
        <image class="head_img" src="/assets/images/head.png"></image>
      </view>
      <view class="infos">
        <view class="name">{{userinfo.Name}}</view>
        <view class="opp">
          <picker bindchange="bindPickerChange" value="{{statusIndex}}" range="{{statusArr}}"  range-key="name">
            <view class="pickerView">
              {{statusArr[statusIndex].name}}
            </view>
          </picker>
        </view>
        <view class="cars">
            <view class="pai" bind:tap="handlecarpai">{{carinfo.Name}}</view>
            <view class="cartype">{{carinfo.OnLineCarType_Name}}</view>
        </view>
        <view class="tel">
          <view class="telinfo">{{userinfo.Phone}}</view>
        </view>
      </view>
    </view>
    <view class="shou">
      <view class="shouitem">
          <view class="xiangmu">总收入</view>
          <view class="nums">
              <text class="values">0</text>
          </view>
      </view>
      <view class="shouitem">
          <view class="xiangmu">已结算</view>
          <view class="nums">
              <text class="values">0</text>
          </view>
      </view>
      <view class="shouitem">
          <view class="xiangmu">总单量</view>
          <view class="nums">
              <text class="values">0</text>
          </view>
      </view>
    </view>
    <view class="weui-panel">
			<view class="weui-panel__bd">
				<view class="weui-media-box weui-media-box_small-appmsg">
					<view class="weui-cells">
						<a class="weui-cell weui-cell_active weui-cell_access weui-cell_example" bindtap="carInfo">
							<view class="weui-cell__hd">
                <image src="/assets/images/cheliang.png"style="width: 20px; height: 20px; margin-right: 16px; display: block;"></image>
              </view>
							<view class="weui-cell__bd weui-cell_primary">
								<view class="font-28">车辆信息</view>
							</view>
							<text class="weui-cell__ft"></text>
						</a>
            <!-- <a class="weui-cell weui-cell_active weui-cell_access weui-cell_example" bindtap="goYue">
							<view class="weui-cell__hd">
                <image src="/assets/images/pingjia.png"style="width: 20px; height: 20px; margin-right: 16px; display: block;"></image>
              </view>
							<view class="weui-cell__bd weui-cell_primary">
								<view class="font-28">乘客评价</view>
							</view>
							<text class="weui-cell__ft"></text>
						</a> -->
            <a class="weui-cell weui-cell_active weui-cell_access weui-cell_example" bindtap="goCoupon">
							<view class="weui-cell__hd">
                <image src="/assets/images/ribao.png"style="width: 20px; height: 20px; margin-right: 16px; display: block;"></image>
              </view>
							<view class="weui-cell__bd weui-cell_primary">
								<view class="font-28">日程单</view>
							</view>
							<text class="weui-cell__ft"></text>
						</a>
            <a class="weui-cell weui-cell_active weui-cell_access weui-cell_example" bindtap="renzheng">
							<view class="weui-cell__hd">
                <image src="/assets/images/gengxin.png"style="width: 20px; height: 20px; margin-right: 16px; display: block;"></image>
              </view>
							<view class="weui-cell__bd weui-cell_primary">
								<view class="font-28">版本信息 <text class="banben">v25.0</text></view>
							</view>
							<text class="weui-cell__ft"></text>
						</a>
            <a class="weui-cell weui-cell_active weui-cell_access weui-cell_example" bindtap="bindwx">
							<view class="weui-cell__hd">
                <image src="/assets/images/wx.jpg"style="width: 20px; height: 20px; margin-right: 16px; display: block;"></image>
              </view>
							<view class="weui-cell__bd weui-cell_primary">
								<view class="font-28">绑定微信<text class="banben"></text></view>
							</view>
							<text class="weui-cell__ft"></text>
						</a>
					</view>
				</view>
			</view>
		</view>
    <view class="loginOut" bindtap="loginOut">
      <button class="loginOutButton">退出登录</button>
    </view>
</view>