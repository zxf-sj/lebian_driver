/* pages/login/login.wxss */
page{
  width: 100vw;
  height: 100vh;
  background-color: #fff;
}
.content{
  width: 100vw;
  box-sizing: border-box;
}
.logo{
  width: 100vw;
  text-align: center;
  margin-top: 40rpx;
  box-sizing: border-box;
}
.logoimg{
  width: 326rpx;
  height:136rpx;
  box-sizing: border-box;
}
.inputArea{
  width: 100vw;
  margin-top: 100rpx;
  box-sizing: border-box;
}
.inputTitle{
  margin-left: 60rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-sizing: border-box;
}
.phone{
  height: 80rpx;
  width: 80vw;
  margin-left: 60rpx;
  box-sizing: border-box;
}
.inputPhone{
  height: 80rpx;
  line-height: 80rpx;
  width: 80%;
  box-sizing: border-box;
}
.line{
  border-bottom: 1rpx solid;
  width: 80vw;
  margin-left: 60rpx;
  color: #c7c7c7;
  box-sizing: border-box;
}
.regArea{
  margin-top: 10rpx;
  float: right;
  margin-right: 20rpx;
  box-sizing: border-box;
}
.regText{
  color:#089bf1;
}
.buttonArea{
  width: 100%;
  margin-top: 140rpx;
  text-align: center;
  box-sizing: border-box;
}
.buttons{
  width: 80%;
  background-color: #0a44d8;
  color: #fff;
  box-sizing: border-box;
}
.signUp-tip{ 
  margin: 100rpx auto;
  display: flex;
  justify-content: center;
  font-size: 26rpx;
  color: #999;
  height: 60rpx;
  line-height: 60rpx;
  width: 100%;
  box-sizing: border-box;
  
}
.signUp-tip-txt{
  height: 60rpx;
  line-height: 60rpx;
}
.signUp-tip-txt-protocol{
  font-size: 28rpx;
  color: #0d88d0;
}
